{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "allowImportingTsExtensions": true,
    "strict": true, "noEmit": true, "resolveJsonModule": true,
    "types": ["node", "vite/client"], "skipLibCheck": true
  },
  "include": ["web/src", "shared", "builder/src", "builder/scripts", "tests"]
}
